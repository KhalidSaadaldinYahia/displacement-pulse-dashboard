{
  "name": "DisplacementPulseTheme.json",
  "dataColors": [
    "#34E0C2",
    "#4DA3FF",
    "#FFB454",
    "#FF6F7D",
    "#A78BFA",
    "#57D2FF",
    "#8BE28B"
  ],
  "background": "#06131F",
  "foreground": "#ECF7FF",
  "tableAccent": "#34E0C2",
  "good": "#34E0C2",
  "neutral": "#FFB454",
  "bad": "#FF6F7D",
  "maximum": "#4DA3FF",
  "center": "#152E43",
  "minimum": "#071624",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 15,
      "color": "#F4FAFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#DDEEFF"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#9DB5C7"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#F4FAFF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0B2132"
              }
            },
            "transparency": 8
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1C435B"
              }
            },
            "radius": 10
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    }
  }
}