{
  "name": "Humanitarian Editorial",
  "dataColors": [
    "#C5654D",
    "#66705A",
    "#D09A59",
    "#F05A47",
    "#8C7969",
    "#88957A",
    "#A3A87B"
  ],
  "background": "#F3EFE6",
  "foreground": "#202421",
  "tableAccent": "#C5654D",
  "good": "#66705A",
  "neutral": "#D09A59",
  "bad": "#F05A47",
  "maximum": "#C5654D",
  "center": "#D8CBB8",
  "minimum": "#F3EFE6",
  "textClasses": {
    "title": {
      "fontFace": "Aptos Display Semibold",
      "fontSize": 16,
      "color": "#202421"
    },
    "header": {
      "fontFace": "Aptos Semibold",
      "fontSize": 12,
      "color": "#343934"
    },
    "label": {
      "fontFace": "Aptos",
      "fontSize": 10,
      "color": "#66705A"
    },
    "callout": {
      "fontFace": "Aptos Display Semibold",
      "fontSize": 30,
      "color": "#202421"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFDF8"
              }
            },
            "transparency": 4
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D8CBB8"
              }
            },
            "radius": 3
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 14,
            "right": 14
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    }
  }
}