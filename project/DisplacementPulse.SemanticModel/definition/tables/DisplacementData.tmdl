table DisplacementData
	lineageTag: d9c1f7d5-ce73-4107-8898-b6ba5fadfeef

	/// Refugees in the latest year of the current filter context; year-axis visuals retain each year
	measure 'Total Refugees' = CALCULATE(SUM(DisplacementData[Refugees]), DisplacementData[Year] = MAX(DisplacementData[Year]))
		formatString: #,0
		lineageTag: a42c105f-8aa0-437d-aaee-00ddf02ffe75

	/// People with pending asylum claims in the latest selected year
	measure 'Total Asylum Seekers' = CALCULATE(SUM(DisplacementData[Asylum Seekers]), DisplacementData[Year] = MAX(DisplacementData[Year]))
		formatString: #,0
		lineageTag: bc3df59f-598c-4bea-90cb-f434b4d9dbc5

	/// Internally displaced people in the latest selected year
	measure 'Total Internally Displaced' = CALCULATE(SUM(DisplacementData[Internally Displaced]), DisplacementData[Year] = MAX(DisplacementData[Year]))
		formatString: #,0
		lineageTag: 1602651b-d870-44e8-842f-e6940bb981b5

	/// Sum of the three displayed categories; excludes Other People in Need
	measure 'Displaced People Total' = [Total Refugees] + [Total Asylum Seekers] + [Total Internally Displaced]
		formatString: #,0
		lineageTag: 73fb7224-b8ef-4341-ae52-7b752bdc2576

	/// Number of origins in the current filter context
	measure 'Origin Count' = DISTINCTCOUNT(DisplacementData[Origin Code])
		formatString: 0
		lineageTag: f51a2871-3837-47c3-b9a2-b3cde89f2eec

	/// Latest year in the current filter context
	measure 'Latest Year' = MAX(DisplacementData[Year])
		formatString: 0
		lineageTag: cd7693de-329b-4a82-ad0b-45386642d8cb

	/// Share of the displayed displacement total represented by IDPs
	measure 'IDP Share' = DIVIDE([Total Internally Displaced], [Displaced People Total])
		formatString: 0.0%
		lineageTag: fd840610-5891-4c95-9bb9-c65d81c643bf

	/// Origin share of the selected displacement total
	measure 'Share of Selected Total' = DIVIDE([Displaced People Total], CALCULATE([Displaced People Total], ALLSELECTED(DisplacementData[Origin])))
		formatString: 0.0%
		lineageTag: 5bf32d39-466a-4902-96d4-ca9432222b98

	column Origin
		dataType: string
		lineageTag: c494c48a-d672-4aeb-87c2-a73a53c2aa40
		sourceColumn: Origin Name

	column 'Origin Code'
		dataType: string
		lineageTag: 373dd0ed-f2af-43d1-bf7c-57e1d3aa2b9a
		sourceColumn: Origin Code

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 982c7124-16cf-427a-94c4-db887e018924
		summarizeBy: none
		sourceColumn: Year

	column Refugees
		dataType: int64
		formatString: #,0
		lineageTag: d0597778-13b1-4291-8358-070808995225
		summarizeBy: sum
		sourceColumn: refugees

	column 'Asylum Seekers'
		dataType: int64
		formatString: #,0
		lineageTag: dd0569d7-1ca6-4cae-8e9a-8ea76ee57a02
		summarizeBy: sum
		sourceColumn: asylum_seekers

	column 'Internally Displaced'
		dataType: int64
		formatString: #,0
		lineageTag: e5f7d5d2-555e-48c4-826b-bedee73468a4
		summarizeBy: sum
		sourceColumn: idps

	column 'Total Displaced'
		dataType: int64
		formatString: #,0
		lineageTag: ce89b43f-c8e2-4198-bacb-ea443fd8248a
		summarizeBy: sum
		sourceColumn: total_displaced

	column Region
		dataType: string
		lineageTag: 538b962e-0bca-4470-829c-24ff73c3fecc
		sourceColumn: region

	column 'Other People in Need'
		dataType: int64
		formatString: 0
		lineageTag: 7bf4ac7b-f1eb-4d42-9ebe-64d916078456
		summarizeBy: sum
		sourceColumn: Other People in Need

		annotation SummarizationSetBy = Automatic

	partition DisplacementData = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/KhalidSaadaldinYahia/displacement-pulse-dashboard/61d2355e4e74fb8cfb679ed028624bf8ba159a76/project/data/displacement_by_origin.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(PromotedHeaders, {{"Origin Name", type text}, {"Origin Code", type text}, {"Year", Int64.Type}, {"refugees", Int64.Type}, {"asylum_seekers", Int64.Type}, {"idps", Int64.Type}, {"total_displaced", Int64.Type}, {"region", type text}, {"Other People in Need", Int64.Type}})
				in
					Typed
